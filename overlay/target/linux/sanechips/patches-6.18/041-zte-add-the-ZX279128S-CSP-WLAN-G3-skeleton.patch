--- a/drivers/net/ethernet/zte/Kconfig
+++ b/drivers/net/ethernet/zte/Kconfig
@@ -82,4 +82,15 @@
 
 	  If unsure, say Y on this board.
 
+
+config ZX_CSP_WLAN
+	bool "ZTE ZX279128S vendor-native MT7916 G3 skeleton"
+	depends on ZX279128S_ETH && PCI
+	help
+	  Probe/maps the companion PCIe function 14c3:790a and audits the
+	  vendor MT7916 firmware files. It does not write any MT7916 register
+	  and refuses the device until zxnpu_wlan.enable=1.
+
+	  If unsure, say Y on this board.
+
 endif # NET_VENDOR_ZTE
--- a/drivers/net/ethernet/zte/Makefile
+++ b/drivers/net/ethernet/zte/Makefile
@@ -6,3 +6,4 @@
 zx279128s-eth-$(CONFIG_ZX_NPU_AUDIT) += zx279128s-npu-audit.o
 zx279128s-eth-$(CONFIG_ZX_NPU_IDM) += zx279128s-npu-idm.o
 zx279128s-eth-$(CONFIG_ZX_NPU_PPE) += zx279128s-npu-ppe.o
+zx279128s-eth-$(CONFIG_ZX_CSP_WLAN) += zxnpu-wlan.o
