--- a/drivers/net/ethernet/zte/Kconfig
+++ b/drivers/net/ethernet/zte/Kconfig
@@ -73,4 +73,18 @@
 	  register writes also require commit=1.
 
 	  If unsure, say Y on this board.
+
+config ZXNATIVE_ETH
+	bool "ZTE ZX279128S native wired data plane (P2)"
+	depends on OF && PHYLINK
+	help
+	  Standalone vendor-behaviour rewrite of the switch/GMAC/DMA data
+	  path, in place of the baseline vendor-port driver (CONFIG off in
+	  this image - the native rewrite owns the GMAC, doc 62 A1). Port
+	  MACs live in an nvmem cell of the flash partition layout, so the
+	  probe defers until the MTD stack is up; the deferred retry then
+	  brings the real addresses. enable=0 at boot declines the probe.
+
+	  If unsure, say Y on this board.
+
 endif # NET_VENDOR_ZTE
--- a/drivers/net/ethernet/zte/Makefile
+++ b/drivers/net/ethernet/zte/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_ZXNATIVE_ETH) += zxnative-eth.o
 obj-$(CONFIG_ZX279128S_ETH) += zx279128s-eth.o
 zx279128s-eth-y := zx279128s-main.o zx279128s-ppe.o zx279128s-switch.o
 obj-$(CONFIG_ZX_NPU) += zx279128s-npu.o
