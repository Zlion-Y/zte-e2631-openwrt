 endif # ETHERNET
diff -ruN a/drivers/net/ethernet/Makefile b/drivers/net/ethernet/Makefile
--- a/drivers/net/ethernet/Makefile	2026-10-30 01:45:36.050630300 +0800
+++ b/drivers/net/ethernet/Makefile	2026-10-30 01:45:36.090151800 +0800
@@ -108,3 +108,4 @@
 obj-$(CONFIG_NET_VENDOR_SYNOPSYS) += synopsys/
 obj-$(CONFIG_NET_VENDOR_PENSANDO) += pensando/
 obj-$(CONFIG_OA_TC6) += oa_tc6.o
+obj-$(CONFIG_NET_VENDOR_ZTE) += zte/
diff -ruN a/drivers/net/ethernet/zte/Kconfig b/drivers/net/ethernet/zte/Kconfig
--- a/drivers/net/ethernet/zte/Kconfig	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/net/ethernet/zte/Kconfig	2026-10-30 01:45:36.088147400 +0800
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config NET_VENDOR_ZTE
+	bool "ZTE devices"
+	depends on ARCH_ZTE || COMPILE_TEST
+	default y
+	help
+	  If you have a network (Ethernet) device belonging to this class, say Y.
+
+	  Note that the answer to this question doesn't directly affect the
+	  kernel: saying N will just cause the configurator to skip all
+	  the questions about ZTE devices.
+
+if NET_VENDOR_ZTE
+
+config ZX_NPU
+	bool "ZTE ZX279128S npu scaffold"
+	depends on OF
+	help
+	  Builds the npu scaffold. It exposes /proc/zx-npu/status and performs
+	  no MMIO access; the vendor-native wired and MT7916 data paths are
+	  added incrementally on the native line.
+
+	  If unsure, say Y on this board.
+
+endif # NET_VENDOR_ZTE
diff -ruN a/drivers/net/ethernet/zte/Makefile b/drivers/net/ethernet/zte/Makefile
--- a/drivers/net/ethernet/zte/Makefile	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/net/ethernet/zte/Makefile	2026-10-30 01:45:36.089152000 +0800
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_ZX_NPU) += zx279128s-npu.o
