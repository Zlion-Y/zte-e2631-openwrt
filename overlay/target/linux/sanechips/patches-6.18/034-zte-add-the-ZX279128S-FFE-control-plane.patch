--- a/drivers/net/ethernet/zte/Kconfig
+++ b/drivers/net/ethernet/zte/Kconfig
@@ -24,4 +24,16 @@
 	  Each switch port becomes its own network interface, such as the
 	  four LAN ports and the WAN port of the ZTE ZXHN H3600.
 
+
+config ZX_FFE
+	bool "ZTE ZX279128S FFE control plane (vendor-scheme rebuild)"
+	depends on ZX279128S_ETH
+	help
+	  The Fast Forward Engine control plane rebuilt from the vendor
+	  cspkernel 4.1 reverse engineering: flows are learned into a keyed
+	  table and handed to the PPE hardware layer; IPv6 stays on the CPU
+	  until the vendor nat6 key tables are reconstructed. See the FFE
+	  branch's re/ffe/ for the RE basis.
+
+	  If unsure, say Y on this board.
 endif # NET_VENDOR_ZTE
--- a/drivers/net/ethernet/zte/Makefile
+++ b/drivers/net/ethernet/zte/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-$(CONFIG_ZX279128S_ETH) += zx279128s-eth.o
 zx279128s-eth-y := zx279128s-main.o zx279128s-ppe.o zx279128s-switch.o
+zx279128s-eth-$(CONFIG_ZX_FFE) += zx279128s-ffe.o
