From 0c3602121 Mon Sep 17 00:00:00 2001
From: cnjn <unknown>
Date: Fri, 2 Oct 2026 12:00:00 +0800
Subject: [PATCH] mtd, jffs2: keep the clean marker out of the OOB of NAND that can be programmed once

SPI-NAND with the on-die ECC enabled regenerates the whole page ECC on every
program and merges it with what the cell already holds, so a page written in two
passes comes back uncorrectable (-EBADMSG) or, worse, silently miscorrected.
Standard JFFS2 does exactly that: after an erase it writes the clean marker into
the OOB of page 0 on its own, and the first data node then lands on that same
page.

Add mtd_info.program_once, set it in the SPI-NAND core when the ECC engine in
use is the on-die one, let partitions inherit it, and give such NAND a clean
marker node in the data area that fills the first page instead (the same path
write-buffered NOR already uses). Cost: one page per erase block.

Taken from cnjn/linux-mainline-zte-zxslc-sr1010, commit 0c3602121, where it was
found by mounting a Plugin partition that had been written the standard way:
jffs2 refused to remount it with -EBADMSG and OpenWrt stayed on a read-only root.
It applies to v6.18 with one hunk offset (drivers/mtd/nand/spi/core.c).

diff --git a/drivers/mtd/mtdpart.c b/drivers/mtd/mtdpart.c
index 2876501a7..9805bbfcb 100644
--- a/drivers/mtd/mtdpart.c
+++ b/drivers/mtd/mtdpart.c
@@ -74,6 +74,7 @@ static struct mtd_info *allocate_partition(struct mtd_info *parent,
 	child->oobsize = parent->oobsize;
 	child->oobavail = parent->oobavail;
 	child->subpage_sft = parent->subpage_sft;
+	child->program_once = parent->program_once;
 
 	child->name = name;
 	child->owner = parent->owner;
diff --git a/drivers/mtd/nand/spi/core.c b/drivers/mtd/nand/spi/core.c
index 74750107f..7266f0fbf 100644
--- a/drivers/mtd/nand/spi/core.c
+++ b/drivers/mtd/nand/spi/core.c
@@ -1784,6 +1784,9 @@ static int spinand_init(struct spinand_device *spinand)
 	mtd->ecc_step_size = nanddev_get_ecc_conf(nand)->step_size;
 	mtd->bitflip_threshold = DIV_ROUND_UP(mtd->ecc_strength * 3, 4);
 
+	/* The on-die ECC is generated again at every program of a page. */
+	mtd->program_once = nand->ecc.engine == nand->ecc.ondie_engine;
+
 	ret = spinand_create_dirmaps(spinand);
 	if (ret) {
 		dev_err(dev,
diff --git a/fs/jffs2/erase.c b/fs/jffs2/erase.c
index fda9f4d60..e86b920d0 100644
--- a/fs/jffs2/erase.c
+++ b/fs/jffs2/erase.c
@@ -173,7 +173,7 @@ static void jffs2_erase_failed(struct jffs2_sb_info *c, struct jffs2_eraseblock
 {
 	/* For NAND, if the failure did not occur at the device level for a
 	   specific physical page, don't bother updating the bad block table. */
-	if (jffs2_cleanmarker_oob(c) && (bad_offset != (uint32_t)MTD_FAIL_ADDR_UNKNOWN)) {
+	if (jffs2_nand(c) && (bad_offset != (uint32_t)MTD_FAIL_ADDR_UNKNOWN)) {
 		/* We had a device-level failure to erase.  Let's see if we've
 		   failed too many times. */
 		if (!jffs2_write_nand_badblock(c, jeb, bad_offset)) {
diff --git a/fs/jffs2/fs.c b/fs/jffs2/fs.c
index d175cccb7..72137535b 100644
--- a/fs/jffs2/fs.c
+++ b/fs/jffs2/fs.c
@@ -687,7 +687,7 @@ struct jffs2_inode_info *jffs2_gc_fetch_inode(struct jffs2_sb_info *c,
 static int jffs2_flash_setup(struct jffs2_sb_info *c) {
 	int ret = 0;
 
-	if (jffs2_cleanmarker_oob(c)) {
+	if (jffs2_nand(c)) {
 		/* NAND flash... do setup accordingly */
 		ret = jffs2_nand_flash_setup(c);
 		if (ret)
@@ -720,7 +720,7 @@ static int jffs2_flash_setup(struct jffs2_sb_info *c) {
 
 void jffs2_flash_cleanup(struct jffs2_sb_info *c) {
 
-	if (jffs2_cleanmarker_oob(c)) {
+	if (jffs2_nand(c)) {
 		jffs2_nand_flash_cleanup(c);
 	}
 
diff --git a/fs/jffs2/os-linux.h b/fs/jffs2/os-linux.h
index 86ab014a3..925d6183f 100644
--- a/fs/jffs2/os-linux.h
+++ b/fs/jffs2/os-linux.h
@@ -73,6 +73,7 @@ static inline void jffs2_init_inode_info(struct jffs2_inode_info *f)
 #endif
 
 #define jffs2_is_writebuffered(c) (0)
+#define jffs2_nand(c) (0)
 #define jffs2_cleanmarker_oob(c) (0)
 #define jffs2_write_nand_cleanmarker(c,jeb) (-EIO)
 
@@ -108,7 +109,15 @@ static inline void jffs2_init_inode_info(struct jffs2_inode_info *f)
 #define jffs2_can_mark_obsolete(c) (c->mtd->flags & (MTD_BIT_WRITEABLE))
 #endif
 
-#define jffs2_cleanmarker_oob(c) (c->mtd->type == MTD_NANDFLASH)
+#define jffs2_nand(c) (c->mtd->type == MTD_NANDFLASH)
+
+/*
+ * NAND keeps the clean marker in the OOB, programmed apart from the data of
+ * the first page. A page that can be programmed only once cannot take it
+ * there: it gets a clean marker in the data area instead (see
+ * jffs2_nand_flash_setup()).
+ */
+#define jffs2_cleanmarker_oob(c) (jffs2_nand(c) && !(c)->mtd->program_once)
 
 #define jffs2_wbuf_dirty(c) (!!(c)->wbuf_len)
 
diff --git a/fs/jffs2/scan.c b/fs/jffs2/scan.c
index 62879c218..fd252d76f 100644
--- a/fs/jffs2/scan.c
+++ b/fs/jffs2/scan.c
@@ -113,7 +113,7 @@ int jffs2_scan_medium(struct jffs2_sb_info *c)
 	if (!flashbuf) {
 		/* For NAND it's quicker to read a whole eraseblock at a time,
 		   apparently */
-		if (jffs2_cleanmarker_oob(c))
+		if (jffs2_nand(c))
 			try_size = c->sector_size;
 		else
 			try_size = PAGE_SIZE;
@@ -464,12 +464,12 @@ static int jffs2_scan_eraseblock (struct jffs2_sb_info *c, struct jffs2_eraseblo
 	jffs2_dbg(1, "%s(): Scanning block at 0x%x\n", __func__, ofs);
 
 #ifdef CONFIG_JFFS2_FS_WRITEBUFFER
+	if (jffs2_nand(c) && mtd_block_isbad(c->mtd, jeb->offset))
+		return BLK_STATE_BADBLOCK;
+
 	if (jffs2_cleanmarker_oob(c)) {
 		int ret;
 
-		if (mtd_block_isbad(c->mtd, jeb->offset))
-			return BLK_STATE_BADBLOCK;
-
 		ret = jffs2_check_nand_cleanmarker(c, jeb);
 		jffs2_dbg(2, "jffs_check_nand_cleanmarker returned %d\n", ret);
 
diff --git a/fs/jffs2/wbuf.c b/fs/jffs2/wbuf.c
index bb815a002..ff381ac45 100644
--- a/fs/jffs2/wbuf.c
+++ b/fs/jffs2/wbuf.c
@@ -1186,8 +1186,20 @@ int jffs2_nand_flash_setup(struct jffs2_sb_info *c)
 	if (!c->mtd->oobsize)
 		return 0;
 
-	/* Cleanmarker is out-of-band, so inline size zero */
-	c->cleanmarker_size = 0;
+	if (c->mtd->program_once) {
+		/*
+		 * The OOB cannot be programmed apart from the data, so the clean
+		 * marker is a node in the data area. It takes the whole first
+		 * page: the first node of the block then starts on the next
+		 * page, and no page is programmed twice.
+		 */
+		c->cleanmarker_size = c->mtd->writesize;
+		pr_info("NAND pages can be programmed once: clean markers are in the data, %u bytes\n",
+			c->cleanmarker_size);
+	} else {
+		/* Cleanmarker is out-of-band, so inline size zero */
+		c->cleanmarker_size = 0;
+	}
 
 	if (c->mtd->oobavail == 0) {
 		pr_err("inconsistent device description\n");
diff --git a/include/linux/mtd/mtd.h b/include/linux/mtd/mtd.h
index 63047a113..879f78a16 100644
--- a/include/linux/mtd/mtd.h
+++ b/include/linux/mtd/mtd.h
@@ -374,6 +374,12 @@ struct mtd_info {
 	struct mtd_ecc_stats ecc_stats;
 	/* Subpage shift (NAND) */
 	int subpage_sft;
+	/*
+	 * A page can be programmed only once between two erases: the ECC of the
+	 * whole page is generated at every program and merged with what the
+	 * page already holds, so a page written in pieces cannot be read back.
+	 */
+	bool program_once;
 
 	void *priv;
 
