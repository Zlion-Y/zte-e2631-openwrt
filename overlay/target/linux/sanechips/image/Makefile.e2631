# SPDX-License-Identifier: GPL-2.0-only
#
# E2631 additions. apply.sh makes the base target/linux/sanechips/image/Makefile
# include this file just before $(eval $(call BuildImage)).
#
# The device tree lives in ../dts, not in the kernel tree, because the board
# partition table describes the OpenWrt layout rather than the vendor one.

# An official E2631 upgrade package supplies the 512-byte version header, the
# product string and the slot address table. It is not redistributed here;
# CONFIG_E2631_VENDOR_TEMPLATE must point at a local copy.
E2631_VENDOR_TEMPLATE := $(call qstrip,$(CONFIG_E2631_VENDOR_TEMPLATE))

define Device/zte_zxhn-e2631
  DEVICE_VENDOR := ZTE
  DEVICE_MODEL := ZXHN E2631
  DEVICE_DTS := zx279128s-zte-zxhn-e2631
  DEVICE_DTS_DIR := $(TOPDIR)/target/linux/sanechips/dts
  # The package pads the kernel region so the rootfs starts at slot +0x400000
  # and pads the rootfs so the version header block lands on +0x1400000, which
  # is where the board DTS says both are. +0x400000 is forced by cspboot, which
  # finds the rootfs at slot + ceil(declared kernel size / 128k); the cap below
  # is the marker (32 B) plus the kernel, so an oversized kernel fails here
  # instead of sliding the rootfs out from under the partition table.
  # The 16 MiB rootfs region is what leaves room for LuCI plus an ~8 MiB
  # overlay: the kernel splits the erase blocks behind the squashfs off as
  # rootfs_data, and the header's checksum stops at the squashfs, so that tail
  # is the writable part.
  KERNEL_SIZE := 4096k
  KERNEL := kernel-bin | append-dtb | uImage none | zte-slot-marker | \
	check-size $$(KERNEL_SIZE)
  KERNEL_INITRAMFS := kernel-bin | append-dtb | uImage-ramboot
  # The radio is an MT7916AN + MT7976DN (Filogic 630): the mt7915e driver binds
  # it (its id table carries 14c3:7906/790a), but the firmware it asks for is the
  # mt7916_*.bin set, not mt7915_*.bin - hence kmod-mt7916-firmware here.
  # kmod-nft-offload adds the nft flowtable statement fw4 needs for
  # firewall flow offloading; with it the driver's PPE path
  # (zx279128s-ppe.c) forwards established flows without the CPU.  ubi-utils
  # + block-mount carry the userdata extroot tooling.
  # zte-mesh + luci-app-zte-mesh (vendored from cnjn/zte-mesh): the ZTE
  # multiapd controller in a sandbox, so factory-firmware ZTE child routers
  # can mesh off this box. The ARM32 vendor binary runs natively on this
  # Cortex-A9; the service ships DISABLED (see the package's config).
  # Argon (v1.0..v1.2's default theme) is VENDORED at
  # overlay/package/luci/luci-theme-argon since v1.3: same theme, but no
  # GitHub clone at apply time. Bootstrap stays in the list as the fallback.
  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7916-firmware e2631-fwslot \
	kmod-nft-offload ubi-utils block-mount \
	zte-mesh luci-app-zte-mesh \
	luci-app-e2631 \
	libustream-mbedtls \
	luci luci-i18n-base-zh-cn luci-proto-ppp luci-app-ttyd ttyd \
	luci-theme-argon luci-theme-bootstrap
  # The factory package needs an official package as its version-header
  # template, and those are not redistributed, so it is only built when
  # CONFIG_E2631_VENDOR_TEMPLATE names one. CI leaves it empty and gets
  # sysupgrade.bin; tools/release.mjs packs the factory file locally.
  IMAGES := $(if $(E2631_VENDOR_TEMPLATE),factory.bin )sysupgrade.bin
  IMAGE/factory.bin := e2631-factory
  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
endef
TARGET_DEVICES += zte_zxhn-e2631

# Pack the built kernel and squashfs into the vendor upgrade format, so the
# same file installs from the vendor supgrade.html page or from sysupgrade.
# Kernel and rootfs are stored in the clear: on this board the vendor
# bootloader boots a plaintext uImage and the AES layer only covers the vendor
# rootfs, inside the vendor kernel's own MTD read path.
define Build/e2631-factory
	[ -n "$(E2631_VENDOR_TEMPLATE)" ] || { \
		echo "CONFIG_E2631_VENDOR_TEMPLATE must name an official E2631 package" >&2; exit 1; }
	[ -f "$(E2631_VENDOR_TEMPLATE)" ] || { \
		echo "no such vendor template: $(E2631_VENDOR_TEMPLATE)" >&2; exit 1; }
	node $(TOPDIR)/tools/e2631-mkfactory.mjs pack \
		--template $(E2631_VENDOR_TEMPLATE) \
		--kernel $(IMAGE_KERNEL) --rootfs $(IMAGE_ROOTFS) \
		--rootfs-at 0x400000 --header-at 0x1400000 --out $@
endef
