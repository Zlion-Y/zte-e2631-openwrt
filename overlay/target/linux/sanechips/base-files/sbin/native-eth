#!/bin/sh
# native-eth: P2 switchover between the baseline vendor-port driver
# (zx279128s-eth, boots first and owns 92000000.ethernet) and the native
# rewrite (zxnative-eth). Manual on purpose (doc 62 A1/A4): the first
# hardware probe of the native driver is observed live over SSH, not hidden
# behind an init script. `switch` falls back to the baseline if the native
# probe does not bring a port up within the wait window, so a failed probe
# never costs the management path.
#
#   native-eth status   which driver owns the GMAC, native params
#   native-eth switch   baseline -> native, auto-revert on failure
#   native-eth revert   native -> baseline

BASE=zx279128s-eth
NAT=zxnative-eth
DEV=92000000.ethernet
DRIVERS=/sys/bus/platform/drivers
MARKER=/tmp/native-eth.mode

cur() {
	readlink "$DRIVERS/../devices/platform/soc/$DEV/driver" 2>/dev/null |
		sed 's#.*/##'
}

native_ok() {
	dmesg | grep -q "native wired data plane up" && ip link show lan2 >/dev/null 2>&1
}

do_bind() { # do_bind <driver>
	echo "$DEV" > "$DRIVERS/$1/bind" 2>/dev/null
}

do_unbind() { # do_unbind <driver>
	echo "$DEV" > "$DRIVERS/$1/unbind" 2>/dev/null
}

case "$1" in
status)
	printf 'gmac bound by: %s\n' "$(cur)"
	printf 'native enable: %s offload: %s\n' \
		"$(cat /sys/module/$NAT/parameters/enable 2>/dev/null)" \
		"$(cat /sys/module/$NAT/parameters/offload 2>/dev/null)"
	printf 'marker: %s\n' "$(cat $MARKER 2>/dev/null || echo none)"
	dmesg | grep -E "$NAT" | tail -3
	;;
switch)
	echo 1 > /sys/module/$NAT/parameters/enable
	do_unbind $BASE
	do_bind $NAT
	sleep 10
	if native_ok; then
		echo native > $MARKER
		echo "native-eth: native driver up; baseline released"
		exit 0
	fi
	echo "native-eth: native probe did not come up - reverting to baseline"
	do_unbind $NAT
	do_bind $BASE
	echo baseline > $MARKER
	native_ok || echo "native-eth: WARNING baseline also failed - check TTL"
	exit 1
	;;
revert)
	do_unbind $NAT
	do_bind $BASE
	echo baseline > $MARKER
	echo "native-eth: baseline restored: $(cur)"
	;;
*)
	echo "usage: native-eth <status|switch|revert>"
	exit 2
	;;
esac
