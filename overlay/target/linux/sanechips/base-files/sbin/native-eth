#!/bin/sh
# native-eth: report who owns the ZX279128S GMAC and set the boot-time
# driver race. The native rewrite (zxnative-eth) links AHEAD of the baseline
# vendor-port driver (zx279128s-eth), so at boot it probes first; if its
# probe declines (enable=0 or graceful -ENODEV), the baseline registered
# right after takes the node. Runtime switching is impossible - the baseline
# sets suppress_bind_attrs, so its bind/unbind sysfs attrs do not exist and
# a bound driver can never hand the node over (doc 62 A1).
#
#   native-eth status         who owns the GMAC now, and how
#   native-eth enable <0|1>   set the boot race winner (effective next boot)
#
# Revert to the baseline: native-eth enable 0 && reboot.

BASE=zx279128s-eth
NAT=zxnative-eth

cur() {
	readlink /sys/bus/platform/devices/92000000.ethernet/driver 2>/dev/null |
		sed 's#.*/##'
}

case "$1" in
status)
	printf 'gmac bound by: %s\n' "$(cur)"
	printf 'boot race: native enable=%s (baseline auto-serves if declined)\n' \
		"$(cat /sys/module/$NAT/parameters/enable 2>/dev/null)"
	printf 'native offload param: %s\n' \
		"$(cat /sys/module/$NAT/parameters/offload 2>/dev/null)"
	echo '-- native probe evidence (dmesg):'
	dmesg | grep -E "$NAT|native wired data plane" | tail -5
	;;
enable)
	case "$2" in
	0|1)	echo "$2" > /sys/module/$NAT/parameters/enable
		echo "native-eth: enable=$2 stored; $([ "$2" = 1 ] && echo 'next boot the native rewrite serves the GMAC' || echo 'next boot the baseline takes the node back')" ;;
	*)	echo "usage: native-eth enable <0|1>"; exit 2 ;;
	esac
	;;
*)
	echo "usage: native-eth <status|enable <0|1>>"
	[ "$(cur)" = "$NAT" ] || echo "note: the baseline currently serves the GMAC; enable=1 + reboot to race the native driver in"
	exit 2
	;;
esac
