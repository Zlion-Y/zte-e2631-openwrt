#!/bin/sh
# WAN Port Selection: manual assignment of any physical port as WAN.
#
# The gmac driver creates four netdevs according to DTS labels (lan1, lan2, lan3, wan).
# Which port acts as WAN depends solely on which netdev the "wan" interface binds to,
# and which netdevs are members of "br-lan":
#   wan (wan6) re-bound to target port -> target port removed from br-lan -> others kept in br-lan
#
# Usage:
#   e2631-wanport status          Show current binding, bridge members, link state and MACs
#   e2631-wanport apply <port>    Bind WAN to specified port (lan1|lan2|lan3|wan)
#   e2631-wanport selftest        Non-network selftest of configuration and naming
#   DRY_RUN=1 e2631-wanport apply <port>   Print uci commands without executing
#
set -u

PROG=e2631-wanport
CFG=e2631_ports
SYSFS=${E2631_SYSFS:-/sys}

# Sanechips 4x GbE layout
PORTS="lan1 lan2 lan3 wan"

log() {
	logger -t "$PROG" "$*" 2>/dev/null
	echo "$PROG: $*" >&2
}

cfg() { uci -q get "$CFG.global.$1" 2>/dev/null; }

# Bridge membership of a netdev
master_of() {
	local f="$SYSFS/class/net/$1/master"
	[ -e "$f" ] || { echo ""; return 0; }
	readlink -f "$f" 2>/dev/null | sed 's|.*/||'
}

# Factory permanent MAC address
perm_addr() {
	ip -o link show dev "$1" 2>/dev/null \
		| sed -n 's/.*permaddr \([0-9a-fA-F:]\{17\}\).*/\1/p' | head -n 1
}

# Is WAN interface up in netifd
wan_up() {
	ubus call network.interface.wan status 2>/dev/null \
		| grep -q '"up"[[:space:]]*:[[:space:]]*true'
}

# Current WAN netdev
cur_wan_dev() {
	local d
	d=$(uci -q get network.wan.device 2>/dev/null)
	[ -n "$d" ] || d=wan
	echo "$d"
}

# WAN MAC address (preserves factory DUID and upstream DHCP bindings)
wan_mac() {
	local m
	m=$(cfg wan_mac)
	[ -n "$m" ] && { echo "$m"; return 0; }
	m=$(perm_addr wan)
	[ -n "$m" ] || m=$(cat "$SYSFS/class/net/wan/address" 2>/dev/null)
	echo "$m"
}

# Find anonymous br-lan device section in uci
bridge_section() {
	local n=0 name
	while :; do
		name=$(uci -q get "network.@device[$n].name" 2>/dev/null)
		[ -n "$name" ] || { echo ""; return 0; }
		if [ "$name" = "br-lan" ]; then
			echo "network.@device[$n]"
			return 0
		fi
		n=$((n + 1))
	done
}

apply_port() {
	local port=$1 cur bp p mac w6 carrier
	[ -n "$port" ] || { log "Usage: $PROG apply <lan1|lan2|lan3|wan>"; return 1; }
	case " $PORTS " in
	*" $port "*) ;;
	*) log "Invalid port: $port (valid: $PORTS)"; return 1 ;;
	esac
	[ -d "$SYSFS/class/net/$port" ] || { log "Port $port not found in sysfs"; return 1; }

	# Refuse switching if target port has active carrier unless forced
	if [ "$port" != "$(cur_wan_dev)" ] && [ "${FORCE:-0}" != "1" ]; then
		carrier=$(cat "$SYSFS/class/net/$port/carrier" 2>/dev/null)
		if [ "$carrier" = "1" ]; then
			log "Port $port currently has link carrier (likely management cable)."
			log "Switching it to WAN will immediately disconnect management channel."
			log "To proceed anyway, add: --force"
			return 1
		fi
	fi
	[ "$(cfg enabled)" = "0" ] && { log "Disabled in $CFG (enabled=0)"; return 1; }
	cur=$(cur_wan_dev)
	bp=$(bridge_section)
	[ -n "$bp" ] || { log "Could not find br-lan device section in uci"; return 1; }
	mac=$(wan_mac)
	w6=$(uci -q get network.wan6.device 2>/dev/null)
	case "$w6" in
	''|@*) w6="" ;;
	esac

	if [ "${DRY_RUN:-0}" = "1" ]; then
		echo "uci set network.wan.device=$port"
		[ -n "$mac" ] && echo "uci set network.wan.macaddr=$mac"
		[ -n "$w6" ] && echo "uci set network.wan6.device=$port"
		echo "uci -q delete $bp.ports"
		for p in $PORTS; do
			[ "$p" = "$port" ] || echo "uci add_list $bp.ports=$p"
		done
		echo "uci commit network"
		[ -n "$mac" ] && echo "ip link set dev $port address $mac"
		[ "$cur" != "$port" ] && echo "ip link set dev $cur address <br-lan address>"
		return 0
	fi

	uci set network.wan.device="$port"
	[ -n "$mac" ] && uci set network.wan.macaddr="$mac"
	[ -n "$w6" ] && uci set network.wan6.device="$port"
	[ -n "$mac" ] && [ -z "$(cfg wan_mac)" ] && uci set "$CFG.global.wan_mac"="$mac"
	[ -n "$mac" ] && [ "$(cfg manual_port)" != "$port" ] && uci set "$CFG.global.manual_port"="$port"

	uci -q delete "$bp.ports"
	for p in $PORTS; do
		[ "$p" = "$port" ] || uci add_list "$bp.ports=$p"
	done
	uci commit network
	uci commit "$CFG" 2>/dev/null

	log "WAN port remapped: $cur -> $port"
	ensure_port_mac "$port"
	[ "$cur" != "$port" ] && restore_port_mac "$cur"
	echo
	echo "Configuration committed to UCI. Please reboot for switch topology to take effect:"
	echo "  reboot"
	echo "Note: If your management cable is connected to $port, it will become WAN upon reboot."
	return 0
}

restore_port_mac() {
	local p=$1 lanm wm m
	[ -n "$p" ] || return 0
	lanm=$(cat "$SYSFS/class/net/br-lan/address" 2>/dev/null)
	wm=$(wan_mac)
	[ -n "$lanm" ] && [ -n "$wm" ] || return 0
	[ "$lanm" = "$wm" ] && return 0
	m=$(cat "$SYSFS/class/net/$p/address" 2>/dev/null)
	[ "$m" = "$wm" ] || return 0
	ip link set dev "$p" address "$lanm" 2>/dev/null
	return 0
}

ensure_port_mac() {
	local p=$1 mac m
	mac=$(wan_mac)
	[ -n "$mac" ] || return 0
	m=$(cat "$SYSFS/class/net/$p/address" 2>/dev/null)
	[ "$m" = "$mac" ] && return 0
	ip link set dev "$p" address "$mac" 2>/dev/null
	return 0
}

do_status() {
	local bp p
	bp=$(bridge_section)
	echo "enabled         : $(cfg enabled)"
	echo "wan device      : $(cur_wan_dev)"
	if wan_up; then echo "wan up (netifd) : yes"; else echo "wan up (netifd) : no"; fi
	echo "manual_port     : $(cfg manual_port)"
	echo "wan mac         : $(wan_mac)  (saved: $(cfg wan_mac))"
	echo "br-lan section  : ${bp:-<not found>}"
	[ -n "$bp" ] && echo "br-lan ports    : $(uci -q get "$bp.ports" 2>/dev/null | tr '\n' ' ')"
	echo "ports:"
	for p in $PORTS; do
		printf '  %-5s state=%-7s carrier=%s speed=%-5s master=%-7s mac=%s\n' \
			"$p" \
			"$(cat "$SYSFS/class/net/$p/operstate" 2>/dev/null || echo -)" \
			"$(cat "$SYSFS/class/net/$p/carrier" 2>/dev/null || echo 0)" \
			"$(cat "$SYSFS/class/net/$p/speed" 2>/dev/null || echo -)" \
			"$(master_of "$p")" \
			"$(cat "$SYSFS/class/net/$p/address" 2>/dev/null || echo -)"
	done
}

do_selftest() {
	local p bp ok=0
	bp=$(bridge_section)
	echo "ports      : $PORTS"
	echo "bridge     : ${bp:-<none>}"
	echo "cur wan    : $(cur_wan_dev)"
	echo "wan mac    : $(wan_mac)"
	for p in $PORTS; do
		if [ -d "$SYSFS/class/net/$p" ]; then
			echo "  $p ok"
		else
			echo "  $p MISSING"
			ok=1
		fi
	done
	[ -n "$bp" ] || { echo "br-lan section missing"; ok=1; }
	command -v ubus >/dev/null 2>&1 || { echo "ubus missing"; ok=1; }
	[ "$ok" = "0" ] && echo "selftest OK"
	return $ok
}

main() {
	local action=${1:-}
	case "$action" in
	apply)
		shift
		for a in "$@"; do
			case "$a" in
			--force) FORCE=1 ;;
			-*) echo "$PROG: unknown option $a" >&2; exit 2 ;;
			*) PORT=${PORT:-$a} ;;
			esac
		done
		apply_port "${PORT:-}"
		;;
	status) do_status ;;
	selftest) do_selftest ;;
	*)
		sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
		exit 2
		;;
	esac
}

main "$@"
