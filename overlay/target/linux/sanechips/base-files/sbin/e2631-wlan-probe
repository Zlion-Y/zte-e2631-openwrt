#!/bin/sh
# e2631-wlan-probe [--commit]
#
# Drives the vendor-native MT7916 bring-up surface exposed by zxnpu-wlan.
# Without --commit it is read-only: CR/BAR dumps, WFDMA ring registers,
# firmware headers and the decoded region tables. With --commit it also
# runs the download chain recovered from mt7916.ko:
#
#   ROM patch  -> PatchSemGet, AddressLen(0x04000000), FwScatter, Finish
#   WM  image  -> per-region AddressLen + FwScatter, FwStart(option,override)
#   WA  image  -> same with the band-1 mode bit and FwStart bit2
#
# Both module parameters must allow it:
#
#   insmod zxnpu-wlan enable=1 commit=1
#
# Every write goes through the driver's own gating; this script never pokes
# hardware directly.

CTL=/proc/zx-csp-wlan/ctl
STAT=/proc/zx-csp-wlan/status

[ -e "$CTL" ] || {
	echo "e2631-wlan-probe: $CTL missing - zxnpu-wlan not loaded (enable=0?)" >&2
	exit 1
}

mode=read
[ "${1:-}" = "--commit" ] && mode=commit

say() { printf '\n### %s\n' "$*"; }

say "module parameters"
for p in enable commit; do
	f=/sys/module/zxnpu_wlan/parameters/$p
	[ -e "$f" ] && echo "$p=$(cat "$f")"
done

say "probe + rings + fw-info + mcuwin"
for c in probe rings fw-info mcuwin fw-state; do
	echo "$c" > "$CTL"
done
sleep 1
cat "$STAT"

say "decoded firmware plans"
for m in wm wa; do
	echo "fw-plan $m" > "$CTL"
done
cat "$STAT"

if [ "$mode" != commit ]; then
	say "read-only run complete; re-run with --commit to exercise the MCU paths"
	exit 0
fi

say "RX event ring init"
printf 'rx-init\n' > "$CTL"
sleep 1

say "ROM patch download (mcu-dl auto)"
echo "mcu-dl zte/mt7916/mt7916_patch_e1_hdr.bin" > "$CTL"
sleep 1
printf 'mcu-recv\n' > "$CTL"
sleep 1

say "WM firmware download"
echo "fw-dl wm" > "$CTL"
sleep 1
printf 'mcu-recv\n' > "$CTL"
sleep 1

say "WA firmware download"
echo "fw-dl wa" > "$CTL"
sleep 1
printf 'mcu-recv\n' > "$CTL"

cat "$STAT"
