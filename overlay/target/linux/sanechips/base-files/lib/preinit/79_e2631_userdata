#!/bin/sh
# E2631: attach the userdata UBI before mount_root, so an already-formatted
# extroot can be picked up.  Never formats, erases or creates volumes here.
#
# Measured on the box (2026-11-07, v1.9.0 first boot), two reasons this hook
# silently did nothing on its first real run:
#   - preinit runs with PATH=/sbin:/bin - there is no /usr/sbin in it, so a
#     bare `ubiattach` (it lives in /usr/sbin) failed with rc=127 before the
#     || return 0 hid it.  Resolve the tool the way fwslot is resolved.
#   - the "inside the chip" containment check compared the window against
#     mtd0's size - but on this board mtd0 is a 1 MiB partition, not the
#     master flash, so the check could never pass.  The kernel cannot
#     register a partition beyond the chip in the first place, and the
#     twice-device-proven /sbin/e2631-userdata-init validates only the name
#     and the offset behind both slots - this hook now does the same.
# If no UBI is attachable the hook still exits silently - boot continues on
# the internal overlay.

e2631_userdata_mtd() {
	# prints the mtd index of the userdata partition, nothing if absent
	for d in /sys/class/mtd/mtd[0-9]*; do
		[ -r "$d/name" ] || continue
		[ "$(cat "$d/name")" = "userdata" ] || continue
		echo "${d##*/mtd}"
		return 0
	done
	return 1
}

e2631_userdata_preinit() {
	idx=$(e2631_userdata_mtd) || return 0
	base=/sys/class/mtd/mtd$idx
	off=$(cat "$base/offset" 2>/dev/null) || return 0

	# the declared window must sit behind both 28 MiB image slots - anything
	# else is a partition-table change we did not sanction, and the safest
	# answer is to not touch it
	[ "$off" -ge $((0x3f00000)) ] || return 0   # 0x3f00000: end of slot B

	if ! grep -qs "^$idx\$" /sys/class/ubi/ubi[0-9]*/mtd_num 2>/dev/null; then
		ubiattach=$(command -v ubiattach || echo /usr/sbin/ubiattach)
		"$ubiattach" -d 0 /dev/ubi_ctrl -m "$idx" >/dev/null 2>&1 || return 0
	fi

	[ "$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)" = "$idx" ] || return 0
	[ "$(cat /sys/class/ubi/ubi0_0/name 2>/dev/null)" = "userdata" ] || return 0
	return 0
}

boot_hook_add preinit_main e2631_userdata_preinit
