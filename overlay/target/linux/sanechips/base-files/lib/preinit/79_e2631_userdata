#!/bin/sh
# E2631: attach the existing userdata UBI before mount_root.
# Never format, erase or create volumes here.

e2631_userdata_preinit() {
    [ "$(cat /sys/class/mtd/mtd10/name 2>/dev/null)" = "userdata" ] || return 0
    [ "$(cat /sys/class/mtd/mtd10/size 2>/dev/null)" = "49283072" ] || return 0

    if ! grep -qs '^10$' /sys/class/ubi/ubi[0-9]*/mtd_num 2>/dev/null; then
        /usr/sbin/ubiattach -d 0 /dev/ubi_ctrl -m 10 >/dev/null 2>&1 || return 0
    fi

    # Require the expected E2631 userdata volume on UBI0.
    # Never initialize or format NAND during boot.
    [ "$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)" = "10" ] || return 0
    [ "$(cat /sys/class/ubi/ubi0_0/name 2>/dev/null)" = "userdata" ] || return 0

    for vol in /sys/class/ubi/ubi[0-9]*_[0-9]*; do
        [ -r "$vol/name" ] || continue
        [ "$(cat "$vol/name")" = "userdata" ] || continue

        v=${vol##*/}
        u=${v%%_*}
        [ "$(cat /sys/class/ubi/"$u"/mtd_num 2>/dev/null)" = "10" ] || continue

        for node in "$u" "$v"; do
            [ -c "/dev/$node" ] && continue
            [ -e "/dev/$node" ] && continue
            [ -r "/sys/class/ubi/$node/dev" ] || continue

            IFS=: read -r major minor < "/sys/class/ubi/$node/dev"
            mknod "/dev/$node" c "$major" "$minor" 2>/dev/null || :
        done
    done
}

boot_hook_add preinit_main e2631_userdata_preinit
