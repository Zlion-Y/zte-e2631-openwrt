#!/bin/sh /etc/rc.common
# Liveness beacon as a boot service, so the console keeps a ruler even when the
# image is freshly flashed and nobody has ssh'd in yet.  START=20 is early (the
# radio loader is START=95), so the first HB lines land before a client can
# associate. What it separates: "the CPU stopped along with everything else" (HB
# goes silent, no AER line, no oops) from "only the wireless path died" (HB keeps
# ticking).
START=20
USE_PROCD=1
PROG=/sbin/e2631-hb

start_service() {
	# Diagnostic beacon is opt-in: every 3 s it prints a line to the serial
	# console and to /root/e2631-hb.log, which is exactly what you want while
	# chasing the association hang and pure noise on a router that just works.
	# "touch /etc/e2631-hb-enable" turns it back on.
	[ -e /etc/e2631-hb-enable ] || return 0
	procd_open_instance hb
	procd_set_param command "$PROG" 3
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
