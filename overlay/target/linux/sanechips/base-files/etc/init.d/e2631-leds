#!/bin/sh /etc/rc.common
# Keeps the tri-colour lamp telling the truth; see /sbin/e2631-leds for the map.
START=12
USE_PROCD=1

start_service() {
	procd_open_instance leds
	procd_set_param command /sbin/e2631-leds
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 3
	procd_close_instance
}
