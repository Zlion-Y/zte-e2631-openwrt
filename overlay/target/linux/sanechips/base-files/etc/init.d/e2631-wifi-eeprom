#!/bin/sh /etc/rc.common
# Stage the MT7916 calibration at boot; do NOT load the driver here.
#
# History of this file, because each step was paid for in power cycles:
#  1) caldata only lived in the jffs2 "wifi" partition while the driver asks for
#     /lib/firmware/mediatek/mt7916_eeprom.bin, so Wi-Fi never came up until that
#     file was staged (see the firmware hotplug hook).
#  2) the two PCIe functions (14c3:7906 main, 14c3:790a ext-HIF) sit on
#     different root ports; loading them in parallel, or letting the PCI core
#     autoprobe the ext-HIF first, produced the dual-HIF setup that died the
#     moment a client associated. Binding only 0x7906 with autoprobe off fixed
#     that, and 790a has stayed unbound since.
#  3) loading the module from here (START=05, still inside rc.d) is where the
#     boot-time stall lived: the console died inside the firmware-DMA window,
#     before ssh came up, so a bad boot was unrecoverable without opening the
#     case. The load now happens in /etc/init.d/e2631-wifi-load (START=95) via
#     /sbin/e2631-wifi-on, after the system is up.
#  4) forcing the link down to Gen1 from here was tried and is wrong for this
#     controller -- see the note in /sbin/e2631-linkspeed usage: a config-space
#     Target-Link-Speed write plus Retrain did not change the speed, dropped
#     DLLLA, and hung every boot.
START=05

start() {
	local fw=mediatek/mt7916_eeprom.bin

	if [ ! -e "/lib/firmware/$fw" ]; then
		FIRMWARE=$fw /etc/hotplug.d/firmware/11-mt76-caldata
		echo "wifi-eeprom: staged $fw=$([ -e "/lib/firmware/$fw" ] && echo yes || echo no)" > /dev/kmsg
	fi
}
