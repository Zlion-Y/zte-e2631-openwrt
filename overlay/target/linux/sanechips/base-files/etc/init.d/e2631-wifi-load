#!/bin/sh /etc/rc.common
# E2631 automatic Wi-Fi startup.
# Keep initialization outside the boot-critical path.

START=95
USE_PROCD=1
DEFER=${DEFER:-25}

start_service() {
    if [ -e /etc/e2631-wifi-noautoload ]; then
        echo "wifi-load: autoload disabled" > /dev/kmsg
        return 0
    fi

    procd_open_instance wifi-boot
    procd_set_param command /sbin/e2631-wifi-boot "$DEFER"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
