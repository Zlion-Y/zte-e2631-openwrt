#!/bin/sh /etc/rc.common
# Extroot activation gate for the 47 MiB userdata partition.
#
# v1.9 default-adopt behaviour:
#   - a formatted volume is enabled for extroot immediately, and the current
#     internal-overlay configuration is COPIED onto it first, so the switch
#     does not orphan the router's settings (the v1.8 behaviour enabled an
#     empty volume and the config stayed behind on the jffs2 overlay);
#   - an UNFORMATTED volume is adopted automatically: the gate runs
#     /sbin/e2631-userdata-init --apply (which re-verifies the partition
#     name, the 47 MiB window behind both slots and the size itself), then
#     migrates and enables in the same boot.  The interactive confirmation
#     that init demands is provided by this gate - the checks it guards are
#     the gate's own: partition found by name, offset >= 0x3f00000, and
#     "a formatted volume is never re-formatted".
#   - opt-out: `uci set e2631.storage.autoadopt='0'; uci commit e2631`
#     restores the v1.8 behaviour (everything stays manual).
#
# The ROM fstab ships with the extroot mount DISABLED, because a read-write
# mount of an unformatted UBI volume would auto-format it (UBIFS
# create_default_filesystem).  This script is the one place that ever flips
# the mount on, and it does so only when the volume carries a real UBIFS
# superblock:
#
#   gate (this script, START=11): format-if-blank, migrate, enable;
#   next boot 79_e2631_userdata   attaches the UBI device in preinit and
#                                 block mounts the volume as /overlay.
#
# USE_PROCD is deliberately UNSET here: rc.common only tests [ -n "$USE_PROCD" ],
# so writing the value 0 still counts as "set", switches into the procd branch
# and replaces start() with a wrapper that does nothing (this script never opens
# a procd instance) - the gate silently never ran. Unset = start() runs.

START=11

vol_device() {
	idx=""
	for d in /sys/class/mtd/mtd[0-9]*; do
		[ -r "$d/name" ] || continue
		if [ "$(cat "$d/name")" = "userdata" ]; then idx=${d##*/mtd}; break; fi
	done
	[ -n "$idx" ] || return 1
	[ "$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)" = "$idx" ] || return 1
	[ "$(cat /sys/class/ubi/ubi0_0/name 2>/dev/null)" = "userdata" ] || return 1
	[ -e /dev/ubi0_0 ] || return 1
	echo /dev/ubi0_0
}

ubifs_formatted() {
	# UBIFS superblock node magic at LEB 0 offset 0: 0x06101831, stored
	# little-endian, so the first bytes are 31 18 10 06.
	# md5sum, not od/hexdump: this image's busybox ships neither applet.
	dev=$(vol_device) || return 1
	[ "$(dd if="$dev" bs=4 count=1 2>/dev/null | md5sum | cut -c1-32)" = "570471baa3a367a44fa9baef107a7216" ]
}

active() { grep -qs ' /overlay .*ubifs' /proc/mounts; }

autoadopt() {
	# explicit opt-out, checked every run so it can be toggled at runtime
	[ "$(uci -q get e2631.storage.autoadopt)" = "0" ] && return 1
	return 0
}

migrate_and_enable() {
	dev=$(vol_device) || return 1
	mkdir -p /tmp/e2631-adopt
	if mount -t ubifs "$dev" /tmp/e2631-adopt; then
		if [ -d /overlay/upper ] && [ ! -e /tmp/e2631-adopt/upper ]; then
			# copy the live internal-overlay configuration onto the
			# volume so enabling extroot does not orphan it
			tar -C /overlay -cf - . 2>/dev/null | tar -C /tmp/e2631-adopt -xf -
			echo "e2631-userdata: configuration migrated to the userdata volume" > /dev/kmsg
		fi
		umount /tmp/e2631-adopt
		rmdir /tmp/e2631-adopt
		uci set fstab.e2631_extroot.enabled='1'
		uci commit fstab
		echo "e2631-userdata: extroot enabled - /overlay moves to the 47 MiB volume on the NEXT boot" > /dev/kmsg
		return 0
	fi
	rmdir /tmp/e2631-adopt 2>/dev/null
	return 1
}

start() {
	# v1.9: the format/migrate/enable sequence runs in PREINIT
	# (lib/preinit/79_e2631_userdata: attach, format-if-blank, then
	# fstools' mount_extroot reads this ROM fstab with enabled='1' and
	# mounts /dev/ubi0_0 as /overlay, falling back to the internal jffs2
	# on failure).  This gate is now a read-only status reporter, plus the
	# opt-out hint for anyone who wants the v1.8 manual flow back.
	st=$(/sbin/e2631-userdata-status 2>/dev/null | head -1)
	if grep -qs ' /overlay .*ubifs' /proc/mounts; then
		echo "e2631-userdata: extroot is the live /overlay" > /dev/kmsg
	elif echo "$st" | grep -q 'READY'; then
		echo "e2631-userdata: volume READY, extroot enabled in fstab" > /dev/kmsg
	elif [ "$(uci -q get e2631.storage.autoadopt)" = "0" ]; then
		echo "e2631-userdata: no formatted volume (auto-adopt is off; run /sbin/e2631-userdata-init)" > /dev/kmsg
	else
		echo "e2631-userdata: volume not ready - preinit adopt failed, see earlier kmsg" > /dev/kmsg
	fi
	return 0
}
