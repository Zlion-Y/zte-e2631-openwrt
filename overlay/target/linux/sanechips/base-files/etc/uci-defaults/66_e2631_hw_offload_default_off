#!/bin/sh
# Hardware flow offloading stays OFF by default on this board.
#
# The wireless acceleration chain (PPE classifier -> IDM ring -> mac80211) was
# taken all the way to a working data path and verified on hardware: 6018
# frames delivered with the ring invariant rx_submit == 2048 + rx_frames
# holding at every sample.  What it cannot do is carry production traffic:
#  - 39% of those frames are broadcast/multicast/ARP, and handing them to
#    mac80211's AP transmit path does not reproduce what the vendor's
#    driver-direct design does, so some sites resolve and others never do;
#  - a flow that entered the classifier cannot fall back per frame - the
#    kernel flowtable has handed it over for good - and the vendor's
#    equivalent (conntrack-linked flush plus retry) is a large state machine
#    we have not rebuilt;
#  - on top of that the air is lossy (33% tx failed on 2.4 GHz with a
#    power-saving client), which the first two points turn into visible
#    breakage instead of a retransmit.
# Enable it for experiments with:
#   uci set firewall.@defaults[0].flow_offloading_hw='1'
#   echo 1 > /sys/module/zx279128s_eth/parameters/wifi_offload
# The software flowtable (flow_offloading=1) is what carries traffic here.
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q set firewall.@defaults[0].flow_offloading='1'
uci commit firewall
exit 0
