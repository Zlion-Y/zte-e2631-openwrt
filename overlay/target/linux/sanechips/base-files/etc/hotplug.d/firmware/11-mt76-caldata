#!/bin/sh

[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

# The ZTE firmware keeps the MT7915/MT7916 calibration as the file "caldata" in
# the JFFS2 filesystem of the "wifi" partition. On the E2631 that partition is
# mounted by the vendor system at /wlan and holds one 0x30000-byte caldata
# whose first two bytes are 16 79, the chip ID 0x7916; the H3600 card reads
# 15 79 (0x7915).
zte_caldata_from_jffs2() {
	local part dir=/tmp/wifi-caldata id

	part=$(find_mtd_part wifi)
	[ -n "$part" ] || caldata_die "no mtd device found for partition wifi"

	# Not "-o ro": jffs2 refuses a read-only mount on a device it can write,
	# so that would only make this hook fail. The vendor system mounts the same
	# partition read-write at /wlan (seen on the live box:
	# /dev/mtdblock3 on /wlan type jffs2 (rw,relatime)); we only read a file
	# out of it and unmount.
	mkdir -p $dir
	mount -t jffs2 $part $dir || caldata_die "failed to mount $part"
	id=$(hexdump -v -n 2 -e '2/1 "%02x"' $dir/caldata 2>/dev/null)
	case "$board:$id" in
	zte,zxhn-h3600:1579)
		caldata_from_file $dir/caldata 0x0 0xe00
		;;
	zte,zxhn-e2631:1679)
		# The whole card file: the driver memcpy()s only the first
		# MT7916_EEPROM_SIZE (4096) bytes of it, and the rest of the region is
		# where its precal/DPD sections live, so handing over the complete file
		# is both correct and what the vendor system does.
		caldata_from_file $dir/caldata 0x0 0x30000
		;;
	*)
		echo "caldata: chip id $id in $part is not this board's Wi-Fi chip"
		;;
	esac
	umount $dir
	rmdir $dir
}

board=$(board_name)

case "$FIRMWARE" in
"mediatek/mt7915_eeprom.bin"|\
"mediatek/mt7915_eeprom_dbdc.bin"|\
"mediatek/mt7916_eeprom.bin")
# mt7915_eeprom_name() picks the file by *chip id*, and the E2631's MT7916AN
# answers 0x7916 - so "mt7916_eeprom.bin" is the name this board is asked for,
# not the mt7915 one. Both names are accepted because the request also carries
# no band information: the main function (14c3:7906) and the ext-HIF function
# (14c3:790a) ask for the same file.
	case "$board" in
	zte,zxhn-h3600|zte,zxhn-e2631)
		zte_caldata_from_jffs2
		;;
	esac
	;;
esac
