--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -929,12 +929,30 @@
 	ieee80211_teardown_sdata(IEEE80211_DEV_TO_SUB_IF(dev));
 }
 
+/* ZX279128S ethernet driver, built-in: takes TC_SETUP_FT of a wireless
+ * netdev and programs its flows into the packet processor (see
+ * zx279128s-idm.c).  -EOPNOTSUPP means it is not there or not
+ * interested, and the normal driver path runs.
+ */
+int zx_wifi_flow_offload(struct net_device *dev, enum tc_setup_type type,
+			 void *type_data);
+
 static int ieee80211_netdev_setup_tc(struct net_device *dev,
 				     enum tc_setup_type type, void *type_data)
 {
 	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
 	struct ieee80211_local *local = sdata->local;
 
+	/* The flowtable of fw4 carries the wireless devices: offer every
+	 * flow block of a wireless netdev to the packet processor first.
+	 */
+	if (type == TC_SETUP_FT) {
+		int zr = zx_wifi_flow_offload(dev, type, type_data);
+
+		if (zr != -EOPNOTSUPP)
+			return zr;
+	}
+
 	return drv_net_setup_tc(local, sdata, dev, type, type_data);
 }
 
