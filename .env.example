# Copy to .env (untracked, gitignored) to move any of these off their defaults.
# An exported shell variable wins over this file, and this file wins over the
# defaults in scripts/env.sh.
#
# Values are LITERAL - no ~ expansion, and only the keys listed in scripts/env.sh
# are read. Write absolute paths, or a path relative to E2631_WORK: a relative
# value resolves against that directory both in the shell helpers and in
# host/release.mjs, which is what makes one file usable from Linux and Windows.

# Where the build outputs go. $E2631_WORK/out is what docs/ mean by "out/".
E2631_WORK=/home/you/e2631-work

# The OpenWrt checkout the overlay is applied to. scripts/bootstrap.sh clones it.
E2631_TREE=/home/you/openwrt

# The base tree. This port is keyed to one commit of it: the target config edits
# and the kernel patches are written against these files, and apply.sh warns when
# the checkout is not at this commit.
E2631_BASE_REPO=https://github.com/Zlion-Y/openwrt-sanechips-mirror
E2631_BASE_BRANCH=pr-zte-zxhn-h3600
E2631_BASE_SHA=db8b8d4130457dbe46558a7cea872dd2dae539e6

# Optional: the version-header template. Leave this unset and packing uses
# seed/vendor-verhdr-8b8.bin, the 532-byte header slice that ships with the repo -
# that is all `pack` reads out of a template. Set it to a full official ZTE upgrade
# package (relative form: <E2631_WORK>/vendor/...) only for mkfactory selftest/info,
# or to re-verify the shipped slice against vendor bytes you own.
#E2631_TEMPLATE=vendor/zxhn-e2631-official.bin

# Optional: stamp the OpenWrt version into the 32-byte version field of the vendor
# header, so the LuCI slot table tells the OpenWrt slot from the stock one (the
# template carries the vendor's own "V1.0.0.8B8.8000" - without this both slots
# read identically). ASCII only, 31 bytes max. The 16-byte build field is always
# stamped: E2631_BUILD, else the pack date (YYYYMMDD).
#E2631_VERSION=OpenWrt v1.3
#E2631_BUILD=20261025

# Optional HTTP(S) proxy for the download phases. Leave it unset on a box with a
# working direct route.
#E2631_PROXY=http://192.168.1.10:7897
